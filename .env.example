# 必須
ANTHROPIC_API_KEY=sk-ant-...

# --- 以下は任意(書かなければ既定値) ---
# TARS_MODEL=claude-haiku-4-5-20251001     # 速さ重視。会話の質重視なら claude-sonnet-5-5
# TARS_USER_NAME=                          # TARSに呼ばせたい名前
# TARS_WEB_SEARCH=1                        # ネット検索(天気・ニュースなど)。0 で無効
# TARS_LOCATION=東京                       # 場所を言わずに天気を聞いたときの場所
# TARS_MEMORY_FILE=memory.json             # 長期記憶の保存先。消せば記憶がリセットされる
# TARS_HUMOR=75
# TARS_HONESTY=90

# 音声認識: mlx(Mac の GPU・既定) / local(CPU, Raspberry Pi 用) / openai
# TARS_WAKE=1                              # 「TARS」と呼んで話しかける。0 でスペースキーだけ
# TARS_FOLLOW_UP_SEC=8                     # 返事のあと、呼ばずに続けて話せる秒数
# TARS_VAD_SILENCE_SEC=0.8                 # これだけ黙ったら話し終わりとみなす
# TARS_STT=mlx
# TARS_MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# TARS_WHISPER_MODEL=small                 # local のときのモデル。遅ければ base、精度重視なら medium

# 音声合成: say(macOS標準) / openai
# TARS_TTS=say
# TARS_TTS_VOICE=Otoya                     # 未インストールなら Reed などの男性声に自動で切替
# TARS_TTS_RATE=280                       # 話す速さ(大きいほど速い)
# TARS_ROBOT_FX=1                          # sox があればロボ声加工

# OpenAI を使う場合
# OPENAI_API_KEY=sk-...

# 画面
# TARS_SCREEN_W=800
# TARS_SCREEN_H=480
# TARS_FULLSCREEN=0
# TARS_FONT=
